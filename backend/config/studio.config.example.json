{
  "schema_version": 2,
  "server": {
    "profile": "local",
    "bind": "127.0.0.1",
    "port": 5000,
    "public_base_url": "http://127.0.0.1:5173",
    "cors_origins": ["http://127.0.0.1:5173"]
  },
  "identity": {
    "user_id": "local-user",
    "display_name": "Propietario local",
    "mapping_version": 1,
    "mapping": {},
    "roles": {
      "local-user": ["admin", "reviewer", "submitter"]
    },
    "trusted_peer_cidrs": ["127.0.0.1/32", "::1/128"]
  },
  "runtime": {
    "root": "backend/data/runtime",
    "database_path": "backend/data/runtime/submissions.sqlite3"
  },
  "limits": {
    "request_body_bytes": 2097152,
    "editor_body_bytes": 12582912,
    "manifest_upload_body_bytes": 12582912,
    "snapshot_files": 10000,
    "snapshot_bytes": 104857600,
    "artifact_bytes": 104857600,
    "log_phase_bytes": 5242880,
    "build_timeout_seconds": 900,
    "builds_global": 2,
    "builds_per_project": 1,
    "storage_spool_bytes": 2147483648,
    "storage_min_free_bytes": 1073741824
  },
  "preview": {
    "bind": "127.0.0.1",
    "origin": "http://127.0.0.1:5001",
    "allowed_origins": ["http://127.0.0.1:5001"]
  },
  "providers": {
    "artifact": "local",
    "build": "local-subprocess",
    "logs": "local",
    "notifications": ["local"],
    "publication": "local",
    "runtime": "local-subprocess"
  },
  "build": {
    "codebuild_project": null,
    "network_preflight": null,
    "approved_image_digest": null,
    "approved_wrapper_sha256": null,
    "probe_version": null,
    "account_id": null,
    "region": null
  },
  "owners": ["toolbox-owner"]
